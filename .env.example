# Server port (defaults to 3000)
PORT=3000

# Application version & GitHub Release Update Checker
KATHAL_VERSION=0.1.0
KATHAL_GITHUB_REPO=Kathal-OS/Kathal

# Local Administrator Authentication (set KATHAL_ADMIN_PASSWORD or configure in-app on first run)
KATHAL_ADMIN_EMAIL=admin@kathal.local
KATHAL_ADMIN_PASSWORD=
KATHAL_JWT_SECRET=

# Local Storage & App Installation Paths (cross-platform: Windows, macOS, Linux)
# Leave blank to use ./data and ./data/apps inside your KATHAL installation directory
KATHAL_DATA_DIR=
KATHAL_APPS_DIR=
KATHAL_LOG_LEVEL=info
