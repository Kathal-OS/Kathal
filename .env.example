# Server port (defaults to 3000)
PORT=3000

# Application version & GitHub Release Update Checker
KATHAL_VERSION=0.1.0
KATHAL_GITHUB_REPO=Kathal-OS/Kathal

# Local Administrator Authentication (set KATHAL_ADMIN_PASSWORD or configure in-app on first run)
KATHAL_ADMIN_EMAIL=admin@kathal.local
KATHAL_ADMIN_PASSWORD=
KATHAL_JWT_SECRET=

# Local Vault Encryption Key for persisted secrets (auto-generated in KATHAL_DATA_DIR if left blank)
KATHAL_VAULT_KEY=

# Local Storage & App Installation Paths (cross-platform: Windows, macOS, Linux)
# Leave blank to use ./data and ./data/apps inside your KATHAL installation directory
KATHAL_DATA_DIR=
KATHAL_APPS_DIR=
KATHAL_PROXY_CONFIG_FILE=
KATHAL_LOG_LEVEL=info

# Phase 1.5 Authentication, Session & Cookie Hardening
KATHAL_ALLOW_SELF_REGISTRATION=false
KATHAL_SESSION_IDLE_HOURS=12
KATHAL_SESSION_MAX_HOURS=72
KATHAL_COOKIE_SECURE=false
KATHAL_ALLOWED_ORIGINS=

# Phase 1.5 Fleet Network Reachability Policy
# Defaults to true for local homelab/LAN RFC1918 ranges; loopback and cloud metadata remain blocked
KATHAL_FLEET_ALLOW_PRIVATE_NETWORKS=true
