# Server port (AI Studio requires 3000)
PORT=3000

# Application version
KATHAL_VERSION=0.1.0

# Authentication
KATHAL_ADMIN_EMAIL=admin@kathal.local
KATHAL_ADMIN_PASSWORD=kathal
KATHAL_JWT_SECRET=

# Storage & Runtime (optional in hosted preview; in-memory defaults active)
KATHAL_DATA_DIR=/data
KATHAL_DB_PATH=/data/kathal.db
DOCKER_HOST=unix:///var/run/docker.sock
KATHAL_LOG_LEVEL=info
